# Copy to /etc/systemd/system/bmc-frontend.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now bmc-frontend
# Needs /home/canvas/apps/bmc-frontend/.env.local with API_URL=http://127.0.0.1:4000
[Unit]
Description=BongoMaker Control panel (bmc-frontend)
After=network.target bmc-backend.service

[Service]
Type=simple
User=canvas
WorkingDirectory=/home/canvas/apps/bmc-frontend
Environment=NODE_ENV=production
# systemd has no shell PATH: if node comes from nvm, replace with its absolute path.
ExecStart=/usr/bin/env node node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
